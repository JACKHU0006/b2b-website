---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';

let message = null;
let error = null;

// 获取 URL 中的 access_token 参数（Supabase 会在邮件链接中附带）
const params = new URL(Astro.request.url).searchParams;
const accessToken = params.get('access_token');
const refreshToken = params.get('refresh_token');

// 如果存在 token，则尝试设置会话（这样用户就处于已登录状态，可以直接修改密码）
if (accessToken && refreshToken) {
  const { error: sessionError } = await supabase.auth.setSession({
    access_token: accessToken,
    refresh_token: refreshToken,
  });
  if (sessionError) {
    error = sessionError.message;
  }
}

// 处理新密码提交
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const newPassword = formData.get('password')?.toString();

  if (newPassword) {
    const { error: updateError } = await supabase.auth.updateUser({ password: newPassword });
    if (updateError) {
      error = updateError.message;
    } else {
      message = 'Password updated successfully! Please login with your new password.';
      // 可选：重定向到登录页
      return Astro.redirect('/en/login');
    }
  } else {
    error = 'Please enter a new password.';
  }
}
---

<BaseLayout title="Reset Password - B2B Website">
  <div class="container">
    <h1>Reset Password</h1>
    {error && <p style="color: red;">{error}</p>}
    {message && <p style="color: green;">{message}</p>}
    {!message && (
      <form method="POST">
        <input type="password" name="password" placeholder="New Password" required />
        <button type="submit">Update Password</button>
      </form>
    )}
    <p><a href="/en/login">Back to Login</a></p>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 500px;
    margin: 2rem auto;
    padding: 2rem;
    border: 1px solid #ddd;
    border-radius: 8px;
  }
  input, button {
    width: 100%;
    padding: 0.5rem;
    margin-top: 0.5rem;
  }
  button {
    background-color: #28a745;
    color: white;
    border: none;
    cursor: pointer;
  }
</style>